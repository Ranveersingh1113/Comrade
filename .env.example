# Comrade — environment variables
# Copy this file to `.env` and fill in real values. Never commit `.env`.

# --- LLM (Google Gemini: primary Flash + escalation Pro) ---
GEMINI_API_KEY=

# --- Supabase (Postgres + Realtime + Auth + Storage) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Scoped role key used by the MCP server / pipeline. NEVER use service_role at runtime.
SUPABASE_SECRET_KEY=

# Verifies user JWTs on the HTTP surface. `npx supabase status` prints the local
# value. The API refuses to authenticate anyone while this is unset.
SUPABASE_JWT_SECRET=

# --- HTTP surface ---
# Comma-separated browser origins allowed to call the API (the Vite dev server).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Execution sandbox ---
# Docker for local development; Box only after its security proof is recorded.
COMRADE_SANDBOX_BACKEND=docker
# Server/worker secret only. Never expose to browser code or repository Boxes.
COMRADE_BOX_API_KEY=
COMRADE_BOX_MAX_ARCHIVE_BYTES=50000000
# Per-turn cap on LLM calls, so one tool loop cannot spend the team's budget.
AGENT_MAX_LLM_CALLS=20
# Prior messages of the thread replayed into the model's context each turn.
AGENT_HISTORY_TURNS=20
# How many agent turns one worker process runs at once. The queue already
# guarantees one active run per THREAD; before this the worker loop itself was
# the thing serialising everything, so one long turn made every other team
# wait behind it. Each slot is a model call and possibly a container, so raise
# this against the host's memory and the sandbox process caps, not on its own.
COMRADE_AGENT_CONCURRENCY=2
# And the per-team ceiling that stops one busy team taking every slot.
# Concurrency without it is a bigger blast radius rather than more throughput.
COMRADE_AGENT_MAX_RUNNING_PER_TEAM=2

# --- Legacy local single-team GitHub fallback ---
GITHUB_PAT=

# --- Direct Postgres connections (RLS-enforced; never service_role) ---
# Table owner: BYPASSRLS. NOT a runtime credential.
#
# It belongs to the one-off migration job (`python -m shared.migrations`) and
# to the test suite, and to nothing that serves a request. Both of those call
# shared.db.allow_table_owner(); the API and both workers never do, so they are
# refused this connection even on a host where the variable is present. Leave
# it out of their environment entirely — a credential a process cannot use is
# still a credential an attacker can read out of it.
COMRADE_DB_URL_ADMIN=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Worker roles — team-scoped via SET LOCAL app.current_team_id, RLS enforced.
COMRADE_AGENT_DB_URL=postgresql://comrade_agent:CHANGE_ME@127.0.0.1:54322/postgres
COMRADE_EXECUTOR_DB_URL=postgresql://comrade_executor:CHANGE_ME@127.0.0.1:54322/postgres
COMRADE_PIPELINE_DB_URL=postgresql://comrade_pipeline:CHANGE_ME@127.0.0.1:54322/postgres
# Cross-team queue/sweep metadata only; it has no access to member content.
# REQUIRED, with no default — a worker without it cannot claim a job, and an
# .env written before this line existed fails 60 tests with
# "COMRADE_CONTROL_DB_URL is not set" until it is added.
COMRADE_CONTROL_DB_URL=postgresql://comrade_control:CHANGE_ME@127.0.0.1:54322/postgres
# PostgREST-style authenticator for user_session (SET ROLE authenticated only).
# Optional locally (falls back to admin); REQUIRED in production.
COMRADE_AUTHENTICATOR_DB_URL=postgresql://comrade_authenticator:CHANGE_ME@127.0.0.1:54322/postgres

# --- GitHub App (how a team's repositories are reached) ---
# Register at https://github.com/settings/apps/new. The four settings that are
# easy to get wrong, and what breaks when they are:
#
#   "Request user authorization (OAuth) during installation": TICKED.
#               This is what sends the `code` proving the person finishing an
#               install can administer it. Without it, connecting is REFUSED
#               rather than done unverified — installation_id is an
#               unauthenticated number in a URL and the ids are sequential.
#   Callback URL:  <frontend>/github/setup
#               NOT the Setup URL. Ticking the box above DISABLES the Setup
#               URL field, and GitHub redirects to the Callback URL instead.
#               Point it anywhere else and installs finish on GitHub and never
#               come back to Comrade.
#               It must match EXACTLY: wildcard matching is off by default for
#               Apps registered after 2026-08-03. Local dev is therefore
#               http://localhost:5173/github/setup
#   Redirect on update: TICKED, so changing which repositories the App can see
#               comes back through the same flow.
#   Webhook URL: <api host>/webhooks/github, with the secret below.
#
#   Repository permissions: Contents read+write (clone, and push a comrade/
#                           branch), Pull requests read+write (open the PR),
#                           Metadata read.
#   Subscribe to events:    Pull request, Push, Issues, Installation.
#
# The private key is minted once on that page and cannot be re-downloaded.
# GITHUB_APP_PRIVATE_KEY takes the PEM as-is, with 
 escapes, or base64.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_SLUG=
# Tick "Request user authorization (OAuth) during installation" on the App and
# set these two. Without them an installation cannot be verified as belonging
# to the person connecting it, and connecting is refused rather than guessed.
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# Shared secret configured on the GitHub App webhook; empty rejects every delivery.
GITHUB_WEBHOOK_SECRET=

# --- What a turn costs ---
# Token counts are always recorded on agent_runs. Cost is only computed when
# you say what a token costs, per MILLION, at the current published rate for
# whatever model agent/agent.py names. Left at 0, cost_usd stays null rather
# than becoming a confidently wrong number — `sum(input_tokens)` still answers
# every question that matters.
GEMINI_INPUT_USD_PER_MTOK=
GEMINI_OUTPUT_USD_PER_MTOK=

# The hourly budget has two dimensions and whichever binds first wins. Turns
# alone is a turnstile: a trivial turn measures ~5,100 input tokens before the
# member types a word, and one that reads twenty files costs orders more.
AGENT_TURNS_PER_HOUR=60
AGENT_TOKENS_PER_HOUR=500000

# --- Dependency environments ---
# Installing a repository's dependencies runs its build hooks with network
# access, so it is per-repository and off until a team lead turns it on. These
# bound what happens once they do.
COMRADE_ENV_MAX_GB=10
# Refuse to build from an unpinned manifest. Off by default: an unhashed
# requirements.txt is the norm in Python, and requiring a lockfile would leave
# this unused by the repositories that need it. A deployment hosting other
# people's code should turn it on.
COMRADE_REQUIRE_LOCKFILE=false

# ---------------------------------------------------------------------------
# Previews
# ---------------------------------------------------------------------------
# The domain a team's own development servers are served from, one hostname per
# process (p-<id>.<this domain>).
#
# 🔴 It MUST be a different domain from the application's. A preview served
# from Comrade's own origin can read the member's Supabase session out of
# localStorage — the team's code is unreviewed and written by a model, and the
# boundary a browser enforces is the origin, not a header.
#
# EMPTY DISABLES PREVIEWS, deliberately. An unconfigured deployment refuses
# with an actionable message rather than falling back to the unsafe
# arrangement, so leaving this blank is a safe state and not a broken one.
COMRADE_PREVIEW_DOMAIN=
# Seconds a single-use launch grant may be redeemed for. It travels in a URL,
# and URLs survive in history and screenshots.
COMRADE_PREVIEW_GRANT_SECONDS=60
# The container the preview proxy runs in — the API. Each preview gets its OWN
# internal network and this container is attached to each one, so previews
# cannot reach each other or the platform. Empty fails closed rather than
# falling back to one shared network, which is what let a preview reach both.
COMRADE_PREVIEW_PROXY_CONTAINER=comrade-api-1

# --- Dependency setup egress ---
# Setup is the one phase with network access, and it runs a repository's own
# build hooks as root. It now runs on a network with NO GATEWAY, where the only
# route out is this registry proxy — so a direct IP, a DNS lookup, an IPv6
# address, a redirect and 169.254.169.254 all fail for the same reason.
#
# BOTH EMPTY DISABLES DEPENDENCY SETUP, deliberately. The previous behaviour
# was unrestricted egress, so "not configured" must mean "no setup" and never
# "setup with the whole internet".
COMRADE_SETUP_PROXY_CONTAINER=
COMRADE_SETUP_PROXY_URL=

# --- Docker access for the workers ---
# The gid of the host's `docker` group. Both workers run as uid 10001 and talk
# to a root:docker socket, so this is what makes it usable; it differs per host
# and a wrong value fails at runtime rather than at build. Find it with:
#   getent group docker | cut -d: -f3
# The API deliberately gets no socket: it is internet-facing and proxies a
# team's own code, and the socket is root on the host.
COMRADE_DOCKER_GID=999
# Wildcard TLS for the preview domain needs a DNS challenge, because there is a
# certificate per domain and the hostnames are generated. NOT on-demand
# issuance: that would ask a rate-limited CA for a certificate for whatever
# hostname a caller invented.
COMRADE_DNS_PROVIDER=
COMRADE_DNS_TOKEN=
