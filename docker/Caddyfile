# TLS and the origins for the product.
#
# TWO domains, and the second one is a security boundary rather than tidiness.
# COMRADE_HOST serves the app; COMRADE_PREVIEW_DOMAIN serves a team's own
# development servers, one hostname per process. They must be different sites:
# a preview on the app's origin can read a member's Supabase session out of
# localStorage, and no amount of header stripping changes that, because the
# boundary a browser enforces is the origin.
#
# The app half below is unchanged, and its reasoning still holds: the browser talks to the SPA
# and to the API on the same origin, so there is no CORS preflight on every
# agent turn and no second certificate to keep alive. The API is mounted under
# /api and `handle_path` strips the prefix, so server/app.py keeps its own
# routes — it never learns it is behind anything.
#
# COMRADE_HOST is the public name. With no domain, an nip.io name works and
# Let's Encrypt will issue for it:  1-2-3-4.nip.io  for the IP 1.2.3.4.
{$COMRADE_HOST} {
	encode zstd gzip

	handle_path /api/* {
		reverse_proxy api:8000 {
			# An agent turn streams NDJSON for as long as the model takes.
			# Caddy's default flush behaviour buffers, which turns a live
			# stream into one silent pause and then everything at once —
			# indistinguishable, from the member's side, from a hang.
			flush_interval -1
			transport http {
				read_timeout 600s
				write_timeout 600s
			}
		}
	}

	handle {
		reverse_proxy frontend:80
	}
}

# ---------------------------------------------------------------------------
# Optional sites.
# ---------------------------------------------------------------------------
#
# 🔴 The preview site used to sit here unconditionally, and previews are OFF by
# default. With COMRADE_PREVIEW_DOMAIN unset the site address rendered as `*.`
# and the tls block as `dns` with no arguments, and the real caddy:2-alpine
# image refused the whole file:
#
#   Error: adapting config using caddyfile: parsing caddyfile tokens for 'tls':
#   wrong argument count or unexpected line ending after 'dns'
#
# Caddy then exits and the public site is down — on an ordinary deployment that
# had simply not turned previews on. Nothing caught it, because the release
# readiness check talked to the API container directly and never through the
# proxy.
#
# A glob that matches nothing is not an error, so an empty conf.d is the
# supported default. See docker/caddy.conf.d/README.md to enable previews.
import /etc/caddy/conf.d/*.caddy
